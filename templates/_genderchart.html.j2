{# Gender balance over the life of a series, drawn like the acceptance rates:
   the pooled total first, then one row per year, most recent at the top.

   Expects `rows`, `total` and `label` to be set by the including template, so
   that the leadership and the programme committee render the same way without
   ever being added together.

   Each bar is three segments. Colour alone says nothing here — every segment
   carries a title, and the counts are written out beside it — because a
   reader who cannot separate the hues must still be able to read the row.

   The total row carries the same three colours at full strength while the
   per-year rows are held back a little. One palette, one emphasis: a second
   set of brighter hues would be a second set to keep in step. #}
{% macro bar(r) -%}
{%- if r.women %}<i class="g-w" style="--w: {{ (100 * r.women / r.total) | round(2) }}%"
  title="{{ r.women }} of {{ r.total }} women"></i>{% endif %}
{%- if r.other %}<i class="g-o" style="--w: {{ (100 * r.other / r.total) | round(2) }}%"
  title="{{ r.other }} of {{ r.total }} another gender"></i>{% endif %}
{%- if r.men %}<i class="g-m" style="--w: {{ (100 * r.men / r.total) | round(2) }}%"
  title="{{ r.men }} of {{ r.total }} men"></i>{% endif %}
{%- endmacro %}
<ol class="ratechart genderchart">
  <li class="is-total">
    <span class="ry">all {{ total.editions }}</span>
    <span class="rb">{{ bar(total) }}</span>
    <span class="rv">{{ total.share }}%<small> of {{ total.total }}</small></span>
  </li>
  {% for r in rows %}
  <li>
    <span class="ry"><a href="{{ r.url }}">{{ r.year }}</a></span>
    <span class="rb">{{ bar(r) }}</span>
    <span class="rv">{{ r.women + r.other }}<small> of {{ r.total }}</small></span>
  </li>
  {% endfor %}
</ol>
<p class="chart-caption genderpooled">Across {{ total.editions }} editions,
  <b>{{ total.women + total.other }} of {{ total.total }}</b> {{ label }}
  were women or of another gender &mdash; {{ total.share }}%.</p>
