{% extends "base.html.j2" %}
{% set ext = conference.extension_summary %}

{% block title %}{{ conference.acronym }} &mdash; {{ config.site.title }}{% endblock %}

{% block meta %}
{% set social_title = conference.acronym ~ ' — ' ~ conference.name %}
{% set social_url = config.site.base_url ~ conference.url %}
{% set social_description %}{{ conference.acronym }}: {{ conference.name }}. Deadlines, venues and acceptance rates across {{ conference.editions | length }} editions.{% endset %}
<meta name="description" content="{{ social_description | oneline }}">
<link rel="canonical" href="{{ social_url }}">
{% include "_social.html.j2" %}
{% endblock %}

{% block content %}
<article>

<header class="page-head">
  <p class="crumbs"><a href="/">All conferences</a> / {{ conference.acronym }}</p>
  <h1 class="page-title">{{ conference.acronym }}</h1>
  <p class="page-sub">{{ conference.name }}</p>

  <div class="page-meta">
    <span class="item">Editions listed<b>{{ conference.editions | length }}</b></span>
    {% if conference.listed_editions %}
    <span class="item">Covered<b>{{ conference.first_year }}&ndash;{{ conference.last_year }}</b></span>
    {% endif %}
    {% if conference.current_rank %}
    <span class="item">Rank now<b>CORE {{ conference.current_rank }}
      {%- if conference.current_rank == 'national' and conference.core_national_of %}
      ({{ conference.core_national_of }}){% endif %}</b></span>
    {% endif %}
    {% if conference.frequency %}
    <span class="item">Frequency<b>{{ conference.frequency }}</b></span>
    {% endif %}
    {% if conference.scope and conference.scope != 'international' %}
    <span class="item">Reach<b>{{ enum('scope', conference.scope).get('label', conference.scope) }}
      {%- if conference.languages %} &middot; {{ conference.languages | join(', ') }}{% endif %}</b></span>
    {% endif %}
  </div>

  {% if conference.defunct or conference.one_off or conference.successors %}
  <div class="status-banner">
    <span class="lead">
      {%- if conference.one_off %}Single event
      {%- elif conference.successors %}Continued
      {%- else %}Discontinued{% endif -%}
    </span>
    <p>
      {% if conference.one_off %}
      A one-off event, never intended to recur.
      {% elif conference.successors %}
      Continues as
      {% for s in conference.successors %}<a href="{{ s.url }}">{{ s.acronym }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.
      {% elif conference.defunct == 'seemingly' %}
      Seemingly discontinued: no edition has been announced for some years.
      {% else %}
      Discontinued after {{ conference.defunct }}.
      {% endif %}
      {% if conference.predecessors %}
      Formed from
      {% for p in conference.predecessors %}<a href="{{ p.url }}">{{ p.acronym }}</a>{% if not loop.last %} and {% endif %}{% endfor %}.
      {% endif %}
    </p>
  </div>
  {% elif conference.predecessors %}
  <div class="status-banner">
    <span class="lead">Merger</span>
    <p>Formed from
      {% for p in conference.predecessors %}<a href="{{ p.url }}">{{ p.acronym }}</a>{% if not loop.last %} and {% endif %}{% endfor %}.
      Figures from before the merger belong to those conferences.</p>
  </div>
  {% endif %}
</header>

<div class="cols">
  <div>
    <section class="panel">
      <h2 class="panel-title">Editions</h2>
      <table class="editions">
        <thead>
          {# An umbrella has no call, no acceptance rate and no proceedings of
             its own — three columns of em dashes. What it has instead is a
             roster, which is the thing worth a column. #}
          <tr><th>Year</th><th class="num">Ed.</th><th>Held</th><th>Where</th>
            {% if conference.umbrella %}<th>What met</th>
            {% else %}<th>Paper deadline</th><th class="num">Accepted</th><th class="num">Rate</th>{% endif %}</tr>
        </thead>
        <tbody>
          {# Consecutive edition numbers across a gap year mean the conference simply
   did not meet: nothing is missing from our records, so say nothing. This
   also covers series running every 18 months. #}
          {% set ns = namespace(previous=None, previous_edition=None) %}
          {% for e in conference.listed_editions %}
          {% if ns.previous and ns.previous - e.year > 1 %}
          {% set missing = range(e.year + 1, ns.previous) | list %}
          {% set contiguous = ns.previous_edition and e.raw.get('edition')
                              and ns.previous_edition - e.raw.edition == 1 %}
          {% if not contiguous %}
          <tr class="gap"><td colspan="{{ 5 if conference.umbrella else 7 }}">
            {% if conference.complete_since and missing | min >= conference.complete_since %}
            no edition in {{ missing | join(', ') }}
            {% else %}
            {{ missing | join(', ') }} &mdash; not recorded here, which does not mean
            the conference did not meet
            {% endif %}
          </td></tr>
          {% endif %}
          {% endif %}
          {% set ns.previous = e.year %}
          {% set ns.previous_edition = e.raw.get('edition') %}
          {% set p = city(e.city_name) %}
          {# e.paper picks the round that is still open; e.deadline('paper')
             would return round 1 and call the edition closed. #}
          {% set paper = e.paper %}
          {% set clock = countdown(paper) %}
          {% set open = clock.days is not none and clock.days >= 0 %}
          <tr{% if e.status in ('cancelled', 'no-edition', 'postponed') %} class="struck"{% endif %}>
            <td class="yr"><a href="{{ e.url }}">{{ e.key }}</a>
              {% if e.status %}
              {% set st = enum('status', e.status) %}
              <span class="statemark" data-state="{{ e.status }}" title="{{ st.get('description', '') }}">{{ st.get('label', e.status) }}</span>
              {% elif open %}
              <span class="statemark" data-state="open" title="Papers are still being accepted">open</span>
              {% endif %}
            </td>
            <td class="num">{% if e.raw.get('edition') %}{{ e.raw.edition }}{% else %}&mdash;{% endif %}</td>
            <td>{{ e.held }}</td>
            <td>
              {%- if e.online %}Online
              {%- elif p.name %}
                {%- if p.get('url') %}<a class="placelink" href="{{ p.url }}">{{ p.display }}</a>
                {%- else %}{{ p.display }}{% endif %} {{ p.flag }}
              {%- else %}&mdash;{% endif %}</td>
            {% if conference.umbrella %}
            <td>
              {%- if e.members %}
              {%- for member in e.members_by_role %}{% for m in member[1] %}
              <a href="{{ m.url }}">{{ m.conference.acronym }}</a>{% if not loop.last %}, {% endif %}
              {%- endfor %}{% if not loop.last %}; {% endif %}{% endfor %}
              {%- else %}&mdash;{% endif %}</td>
            {% else %}
            <td>
              {% if e.status in ('cancelled', 'no-edition') %}&mdash;
              {% elif paper %}{{ paper.effective | date(false) }}
                {% if paper.extended %}<span class="extended">+{{ paper.extension_days }}&nbsp;days</span>
                {% elif e.extensions_known_undated %}<span class="extended">ext.</span>
                {% elif e.extensions_ruled_out %}<span class="firm" title="Checked: this deadline was not extended">firm</span>
                {% endif %}
              {% else %}&mdash;{% endif %}
            </td>
            <td class="num">
              {%- if e.counts -%}{{ e.counts[0] }} / {{ e.counts[1] }}
              {%- else -%}&mdash;{%- endif -%}
            </td>
            <td class="num">{% if e.rate %}{{ e.rate | round | int }}%{% else %}&mdash;{% endif %}</td>
            {% endif %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% if not conference.complete_since %}
      <p class="detail-note">A missing year does not mean the conference did not meet:
        coverage before {{ conference.first_year }} has not been verified.</p>
      {% endif %}
    </section>

    {% if conference.umbrella and conference.membership_grid.years %}
    {% set grid = conference.membership_grid %}
    <section class="panel">
      <h2 class="panel-title">Who was in it, year by year</h2>
      <table class="editions grid">
        <thead>
          <tr><th>Conference</th>
            {% for year in grid.years %}<th class="num yr-col" title="{{ year }}">{{ year % 100 }}</th>{% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for row in grid.rows %}
          <tr>
            <td><a href="{{ row.conference.url }}">{{ row.conference.acronym }}</a>
              {%- if row.role == 'workshop' %} <span class="role">workshop</span>{% endif %}</td>
            {% for year in grid.years %}
            {% set member = row.years.get(year) %}
            <td class="num cell">
              {%- if member %}<a href="{{ member.url }}" title="{{ member.acronym }}">&bull;</a>
              {%- elif row.first < year < row.last %}<span class="gap-cell" title="Not part of it that year">&ndash;</span>
              {%- endif %}</td>
            {% endfor %}
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <p class="chart-caption">Derived from the member editions themselves, so
        it cannot disagree with them. A dash inside a run is a conference that
        left and came back; nothing at the ends is simply when it joined or
        stopped.</p>
    </section>
    {% endif %}

    {% if conference.rated_editions %}
    <section class="panel">
      <h2 class="panel-title">Acceptance rate over time</h2>
      {% include "_ratechart.html.j2" with context %}
      {% set volume = conference.volume_editions %}
      {% if volume | length > 1 %}
      {# The denominator, under the rate. A rate that falls while submissions
         double is not the same story as one that falls at constant volume,
         and the rate alone cannot tell the two apart. #}
      {% set peak = volume | map(attribute='counts') | map(attribute=1) | max %}
      <p class="field-label">Submissions</p>
      <ol class="ratechart volumechart">
        {% for e in volume %}
        <li>
          <span class="ry"><a href="{{ e.url }}">{{ e.year }}</a></span>
          <span class="rb"><i style="--w: {{ (100 * e.counts[1] / peak) | round(2) }}%"></i></span>
          <span class="rv">{{ e.counts[1] }}{% if e.counts_are_summed %}<small> summed</small>{% endif %}</span>
        </li>
        {% endfor %}
      </ol>
      <p class="chart-caption">Scaled to this conference's own busiest year
        ({{ peak }}), so the shape is comparable across its editions but not
        between conferences.</p>
      {% endif %}
    </section>
    {% endif %}

    {% set gender = conference.gender_history %}
    {% if gender %}
    <section class="panel">
      <h2 class="panel-title">Who led each edition</h2>
      <p class="genderkey" aria-hidden="true">
        <span><i class="g-w"></i> women</span>
        {# Only when somebody is recorded as such: a key entry for an empty
           category is noise rather than inclusion. #}
        {% if gender.has_other %}<span><i class="g-o"></i> another gender</span>{% endif %}
        <span><i class="g-m"></i> men</span>
      </p>

      {% if gender.years %}
      <p class="field-label">Chairs and invited speakers</p>
      {% set rows = gender.years %}
      {% set total = gender.total %}
      {% set label = 'chairs and invited speakers' %}
      {% include "_genderchart.html.j2" with context %}
      {% endif %}

      {% if gender.committee_years %}
      <p class="field-label">Programme committee</p>
      {% set rows = gender.committee_years %}
      {% set total = gender.committee_total %}
      {% set label = 'committee members' %}
      {% include "_genderchart.html.j2" with context %}
      {% endif %}

      <p class="chart-caption">Only editions with counted people appear: an
        edition recorded as mixed and nothing more has no arithmetic behind it
        {%- if gender.unquantified %}, and {{ gender.unquantified }} of them
        {{ 'is' if gender.unquantified == 1 else 'are' }} left out on that
        ground{% endif %}. The total counts people, not years, so an edition
        with eight chairs weighs more than one with two. The committee is
        reported beside the platform, never added to it.</p>
    </section>
    {% endif %}
  </div>

  <aside>
    {% if map_points %}
    <section class="panel">
      <h2 class="panel-title">Where it has met</h2>
      {% set map_mode = 'series' %}
      {% set map_tall = true %}
      {% set map_caption %}{{ map_points | length }} cit{{ 'y' if map_points | length == 1 else 'ies' }}.
        {% if map_points | length > 1 %}
        <span class="map-scale"><i>{{ map_points[0].rank }}</i><span
          class="ramp" aria-hidden="true"></span><i>{{ map_points[-1].rank }}</i></span>
        {% endif %}{% endset %}
      {% include "_mapbox.html.j2" %}
      {% if reach %}
      <p class="chart-caption reach">
        {{ reach.cities }} cit{{ 'y' if reach.cities == 1 else 'ies' }}{% if reach.countries %},
        {{ reach.countries }} countr{{ 'y' if reach.countries == 1 else 'ies' }}{% endif %}
        {%- if reach.continents %}, {{ reach.continents }}
        continent{{ 's' if reach.continents != 1 }}{% endif %}.
        {%- if reach.online %} Met online {{ reach.online }}
        time{{ 's' if reach.online != 1 }}.{% endif %}</p>
      {% endif %}
    </section>
    {% endif %}

    {% if conference.core_history %}
    <section class="panel">
      <h2 class="panel-title">CORE rank over time</h2>
      <div class="rank-run">
        {% set history = conference.core_history %}
        {% set newest = conference.last_year %}
        {% for h in history %}
        {% set until = history[loop.index]['from'] if not loop.last else newest + 1 %}
        <span class="seg" data-rank="{{ h.rank }}" style="--w: {{ [until - h['from'], 1] | max }}">
          {{ h.rank }} <small>{{ h['from'] }}{% if not loop.last %}&ndash;{{ until - 1 }}{% else %}&ndash;{% endif %}</small>
        </span>
        {% endfor %}
      </div>
      <p class="chart-caption">
        {% if conference.core_history[0].get('assumed') %}
        Only the current rank is recorded; earlier rounds have not been checked.
        {% elif conference.rank_predates_core %}
        Ranked since the first CORE round.
        {% else %}
        Ranks before {{ conference.core_history[0]['from'] }} are unknown.
        {% endif %}
      </p>
    </section>
    {% endif %}

    {% if conference.homes %}
    <section class="panel">
      <h2 class="panel-title">Met under</h2>
      <dl class="factlist">
        {% for home in conference.homes %}
        <dt><a href="{{ home.conference.url }}">{{ home.conference.acronym }}</a></dt>
        <dd>{{ home.first }}{% if home.last != home.first %}&ndash;{{ home.last }}{% endif %}
          &middot; {{ home.count }} edition{{ 's' if home.count != 1 }}</dd>
        {% endfor %}
      </dl>
    </section>
    {% endif %}

    {% set lead = conference.lead_times %}
    {% set season = conference.deadline_season %}
    {% if lead or season %}
    <section class="panel">
      <h2 class="panel-title">Timing</h2>
      <dl class="factlist">
        {% if season %}
        <dt>Closes</dt>
        <dd>{% if season.settled %}between {{ season.from }} and {{ season.to }}
          {%- else %}anywhere between {{ season.from }} and {{ season.to }}{% endif %},
          over the last {{ season.editions }} editions.</dd>
        {% endif %}
        {% if lead and lead.decision %}
        <dt>Decision</dt>
        <dd>{{ lead.decision.median }} days after the deadline
          {%- if lead.decision.high > lead.decision.low %}
          <small>({{ lead.decision.low }}&ndash;{{ lead.decision.high }} over
            {{ lead.decision.editions }} editions)</small>{% endif %}</dd>
        {% endif %}
        {% if lead and lead.event %}
        <dt>Then</dt>
        <dd>{{ lead.event.median }} days to the conference
          {%- if lead.event.high > lead.event.low %}
          <small>({{ lead.event.low }}&ndash;{{ lead.event.high }})</small>{% endif %}</dd>
        {% endif %}
      </dl>
      {% if season and season.nothing_announced %}
      {# Stated as a pattern, never as a date. Nothing here is a deadline, and
         the wording has to keep saying so. #}
      <p class="chart-caption">No call is open. If it runs again and keeps to
        its habits, expect the next one to close
        {% if season.settled %}in the same window{% else %}somewhere in that
        range{% endif %} &mdash; but that is this page reading a pattern, not
        an announcement.</p>
      {% elif season and not season.settled %}
      <p class="chart-caption">{{ season.spread }} days between the earliest
        and the latest of the last {{ season.editions }}: this one moves.</p>
      {% endif %}
    </section>
    {% endif %}

    {% if ext.known or ext.unknown %}
    <section class="panel">
      <h2 class="panel-title">Deadline habits</h2>
      <dl class="factlist">
        {% if ext.known %}
        <dt>Extended</dt><dd>{{ ext.extended }} of {{ ext.known }} editions
          {%- if ext.firm %} ({{ ext.firm }} confirmed firm){% endif %}</dd>
        {% endif %}
        {% if ext.typical %}<dt>Typical</dt><dd>{{ ext.typical }}</dd>{% endif %}
        {% if ext.longest and ext.varied %}<dt>Longest</dt><dd>{{ ext.longest }} days</dd>{% endif %}
        {% if ext.unknown %}
        <dt>Not known</dt><dd>{{ ext.unknown }} edition{{ 's' if ext.unknown != 1 }}</dd>
        {% endif %}
      </dl>
      <p class="chart-caption">An edition counts as firm only when it was checked;
        a deadline with no earlier date recorded is counted as not known, not as
        firm.</p>
    </section>
    {% endif %}

    <section class="panel">
      <h2 class="panel-title">Elsewhere</h2>
      <dl class="factlist">
        {% if conference.links.get('dblp') %}
        <dt>DBLP</dt><dd><a href="https://dblp.org/db/conf/{{ conference.links.get('dblp') }}/">{{ conference.links.get('dblp') }} &#8599;</a></dd>
        {% endif %}
        {% if conference.core_id %}
        <dt>CORE</dt><dd><a href="https://portal.core.edu.au/conf-ranks/{{ conference.core_id }}/">portal entry {{ conference.core_id }} &#8599;</a></dd>
        {% endif %}
        {% if conference.links.get('wikipedia') %}
        <dt>Wikipedia</dt><dd><a href="https://en.wikipedia.org/wiki/{{ conference.links.get('wikipedia') }}">article &#8599;</a></dd>
        {% endif %}
        {% if conference.links.get('mastodon') %}
        <dt>Mastodon</dt><dd><a href="{{ conference.links.get('mastodon') }}" rel="me">account &#8599;</a></dd>
        {% endif %}
        {% if conference.links.get('bluesky') %}
        <dt>Bluesky</dt><dd><a href="https://bsky.app/profile/{{ conference.links.get('bluesky') }}">{{ conference.links.get('bluesky') }} &#8599;</a></dd>
        {% endif %}
        {% if not (conference.defunct or conference.one_off) %}
        <dt>Calendar</dt><dd><a href="/{{ conference.slug }}/{{ conference.slug }}.ics">Subscribe to {{ conference.acronym }}</a></dd>
        {% endif %}
        <dt>Data</dt><dd><a href="/data/{{ conference.slug }}.json">All editions as JSON</a></dd>
      </dl>
    </section>

    {% if conference.legacy %}
    <section class="panel">
      <h2 class="panel-title">Notes carried over</h2>
      {% if conference.legacy.get('acceptance') %}
      <p class="detail-note"><b>Acceptance:</b> {{ conference.legacy.acceptance }}</p>
      {% endif %}
      {% if conference.legacy.get('extensions') %}
      <p class="detail-note"><b>Extensions:</b> {{ conference.legacy.extensions }}</p>
      {% endif %}
      {% if conference.legacy.get('notes') %}
      <p class="detail-note">{{ conference.legacy.notes }}</p>
      {% endif %}
      <p class="chart-caption">Kept verbatim from the old site while it is being
        turned into structured data.</p>
    </section>
    {% endif %}
  </aside>
</div>

{% set fix = correction(conference) %}
{% if fix %}
<p class="correction">Spotted something wrong on this page?
  <a href="{{ fix }}">Tell us, with a source if you have one &#8599;</a></p>
{% endif %}
</article>
{% endblock %}

{% block scripts %}
{% if map_points %}
<script src="/assets/maps.js?v={{ asset_version }}" defer></script>
{% endif %}
{% endblock %}
